# 换行符规范化：仓库内统一存 LF，工作区按下方规则
* text=auto

# Python 文件在工作区也保持 LF，避免 Windows 下的潜在问题
*.py text eol=lf

# Shell 脚本必须用 LF
*.sh text eol=lf

# 文档与配置文件用 LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows PowerShell 脚本用 CRLF
*.ps1 text eol=crlf

# 二进制资源，不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
